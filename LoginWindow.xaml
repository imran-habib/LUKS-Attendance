<Window x:Class="LuksAttendance.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LUKS Salary Software — Login" Height="250" Width="380"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Icon="Assets/logo.png">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="🔒 Login Required" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Username:" FontSize="14" Width="90" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtUsername" Width="200" FontSize="14" Padding="6"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Password:" FontSize="14" Width="90" VerticalAlignment="Center"/>
            <PasswordBox x:Name="TxtPassword" Width="200" FontSize="14" Padding="6" KeyDown="TxtPassword_KeyDown"/>
        </StackPanel>

        <TextBlock x:Name="TxtError" Grid.Row="3" Text="" Foreground="Red" FontSize="12" Margin="90,0,0,10"/>

        <Button Grid.Row="4" Content="Login" Click="BtnLogin_Click" Padding="14,8" FontSize="14" HorizontalAlignment="Center" FontWeight="Bold"/>
    </Grid>
</Window>
