<Window x:Class="LuksAttendance.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LUKS Attendance &amp; Salary" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/logo.png">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Toolbar -->
        <ToolBar Grid.Row="0" Margin="5">
            <Button x:Name="BtnLoad" Content="📂 Load Attendance" Click="BtnLoad_Click" Padding="8,4"/>
            <Separator/>
            <Button x:Name="BtnPrevious" Content="📁 Load Previous" Click="BtnPrevious_Click" Padding="8,4"/>
            <Separator/>
            <Button x:Name="BtnExportExcel" Content="📊 Export Excel" Click="BtnExportExcel_Click" Padding="8,4" IsEnabled="False"/>
            <Button x:Name="BtnExportPdf" Content="📄 Export PDF" Click="BtnExportPdf_Click" Padding="8,4" IsEnabled="False"/>
            <Button x:Name="BtnPrint" Content="🖨️ Print" Click="BtnPrint_Click" Padding="8,4" IsEnabled="False"/>
        </ToolBar>

        <!-- Main Tab Control -->
        <TabControl Grid.Row="1" x:Name="MainTabs" Margin="5">
            <TabItem Header="📋 Attendance">
                <DataGrid x:Name="AttendanceGrid" IsReadOnly="True"/>
            </TabItem>
            <TabItem Header="💰 Salary">
                <DataGrid x:Name="SalaryGrid"/>
            </TabItem>
            <TabItem Header="👥 Employee DB">
                <DataGrid x:Name="EmployeeGrid"/>
            </TabItem>
            <TabItem Header="⚠️ Issues" x:Name="IssuesTab">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="IssuesGrid" Grid.Row="0"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="5">
                        <TextBlock Text="OUT Time: " VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtResolveTime" Width="80" Margin="5,0"/>
                        <Button Content="✔ Resolve Selected" Click="BtnResolve_Click" Padding="8,4" Margin="5,0"/>
                        <Button Content="Skip Selected" Click="BtnSkip_Click" Padding="8,4"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2">
            <TextBlock x:Name="StatusText" Text="Ready. Load an attendance file to begin."/>
        </StatusBar>
    </Grid>
</Window>
