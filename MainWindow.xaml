<Window x:Class="LuksAttendance.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LuksAttendance"
        Title="LUKS Salary Software v3.1.1 | Built by Imran Habib | Property of LUKS INTERIORS" Height="750" Width="1150"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/logo.png">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Logo Header -->
        <Border Grid.Row="0" Background="#1a237e" Padding="8,6">
            <Grid>
                <Image Source="assets/logo_transparent.png" Height="28" HorizontalAlignment="Left" Margin="10,0,0,0"/>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="SALARY SOFTWARE - v3.1.1" FontSize="24" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Text="Built by Imran Habib — Property of LUKS INTERIORS"
                               FontSize="9" Foreground="#AAB8D2" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Toolbar -->
        <ToolBar Grid.Row="1" Margin="5" Height="50">
            <Button Content="▶ Run Payroll" Click="BtnRunPayroll_Click" Padding="14,8" FontSize="14" Margin="3,0" FontWeight="Bold" Background="#C8E6C9"/>
            <Separator/>
            <Button x:Name="BtnLoad" Content="📂 Load Attendance" Click="BtnLoad_Click" Padding="14,8" FontSize="14" Margin="3,0"/>
            <Separator/>
            <Button x:Name="BtnPrevious" Content="📁 Load Previous" Click="BtnPrevious_Click" Padding="14,8" FontSize="14" Margin="3,0"/>
            <Separator/>
            <Button x:Name="BtnExportExcel" Content="📊 Export Excel" Click="BtnExportExcel_Click" Padding="14,8" FontSize="14" Margin="3,0" IsEnabled="False"/>
            <Button x:Name="BtnExportPdf" Content="📄 Export PDF" Click="BtnExportPdf_Click" Padding="14,8" FontSize="14" Margin="3,0" IsEnabled="False"/>
            <Button x:Name="BtnPrint" Content="🖨️ Print" Click="BtnPrint_Click" Padding="14,8" FontSize="14" Margin="3,0" IsEnabled="False"/>
            <Separator/>
            <Button x:Name="BtnRecalc" Content="🔄 Recalculate" Click="BtnRecalc_Click" Padding="14,8" FontSize="14" Margin="3,0" IsEnabled="False"/>
            <Separator/>
            <ToggleButton x:Name="BtnWeekly" Content="Weekly" IsChecked="True" Click="BtnPeriodToggle_Click" Padding="10,6" FontSize="12" Margin="3,0,0,0" Background="LightGreen" FontWeight="Bold"/>
            <ToggleButton x:Name="BtnMonthly" Content="Monthly" IsChecked="False" Click="BtnPeriodToggle_Click" Padding="10,6" FontSize="12" Margin="0,0,10,0"/>
            <Separator/>
            <Button Content="📥 Batch Import" Click="BtnBatchImport_Click" Padding="14,8" FontSize="14" Margin="3,0" ToolTip="Import old salary exports into database"/>
            <Button Content="📂 DB Location" Click="BtnChangeDbLocation_Click" Padding="14,8" FontSize="14" Margin="3,0" ToolTip="Change database save folder"/>
            <Separator/>
            <Button Content="ℹ️ Rules" Click="BtnRules_Click" Padding="14,8" FontSize="14" Margin="3,0" ToolTip="View salary calculation rules"/>
            <Button Content="❓ Help" Click="BtnHelp_Click" Padding="14,8" FontSize="14" Margin="3,0"/>
        </ToolBar>

        <!-- Main Tab Control -->
        <TabControl Grid.Row="2" x:Name="MainTabs" Margin="5" FontSize="14">
            <TabItem Header="📋 Attendance">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border x:Name="ImportSummaryBanner" Grid.Row="0" Background="#E3F2FD" Padding="10,8" Margin="0,0,0,5" CornerRadius="4" Visibility="Collapsed">
                        <DockPanel>
                            <Button Content="View Issues ➜" DockPanel.Dock="Right" Click="BtnViewIssues_Click" Padding="10,4" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtImportSummary" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </DockPanel>
                    </Border>
                    <DataGrid x:Name="AttendanceGrid" Grid.Row="1" CanUserDeleteRows="True" CanUserAddRows="True" FontSize="13"/>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="5,8">
                        <Button Content="➕ Add Manual Entry" Click="BtnAddManualAttendance_Click" Padding="12,6" FontSize="14" Margin="0,0,10,0"/>
                        <TextBlock Text="(For workers not on the machine — add name, day, IN/OUT times, then click Recalculate)"
                                   VerticalAlignment="Center" FontSize="12" Foreground="Gray"/>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="💰 Salary">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="SalaryGrid" Grid.Row="0" FontSize="13" AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="⚡" Binding="{Binding StatusIndicator}" Width="30" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="100" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="150" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Days" Binding="{Binding Days}" Width="45" IsReadOnly="True"/>
                            <DataGridTextColumn Header="OT" Binding="{Binding OtHours}" Width="50" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Ded" Binding="{Binding DedHours}" Width="50" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Net Hrs" Binding="{Binding NetHours}" Width="60" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Daily" Binding="{Binding DailyRate}" Width="55" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Extra Hrs" Binding="{Binding ExtraHrs}" Width="65"/>
                            <DataGridTextColumn Header="Advance" Binding="{Binding Advance}" Width="70"/>
                            <DataGridTextColumn Header="Arrears" Binding="{Binding Arrears}" Width="65"/>
                            <DataGridTextColumn Header="Net Salary" Binding="{Binding NetSalary}" Width="90" IsReadOnly="True" FontWeight="Bold"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="1" FontSize="11" Foreground="Gray" Margin="5,4"
                        Text="🟢 Normal (±15%)  🟡 Unusual (±30%)  🔴 Significant (>30%)  ⚪ No history"/>
                </Grid>
            </TabItem>
            <TabItem Header="👥 Employee DB">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="EmployeeGrid" Grid.Row="0" CanUserAddRows="True" CanUserDeleteRows="True" FontSize="13" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180"/>
                            <DataGridTextColumn Header="Daily Rate" Binding="{Binding DailyRate}" Width="80"/>
                            <DataGridComboBoxColumn Header="Category" SelectedItemBinding="{Binding Category}" Width="120">
                                <DataGridComboBoxColumn.ItemsSource>
                                    <x:Array Type="sys:String" xmlns:sys="clr-namespace:System;assembly=mscorlib">
                                        <sys:String>Cushioning</sys:String>
                                        <sys:String>Polishing</sys:String>
                                        <sys:String>Carpenter</sys:String>
                                        <sys:String>Helper</sys:String>
                                        <sys:String>Other</sys:String>
                                    </x:Array>
                                </DataGridComboBoxColumn.ItemsSource>
                            </DataGridComboBoxColumn>
                            <DataGridComboBoxColumn Header="Type" SelectedItemBinding="{Binding Type}" Width="90">
                                <DataGridComboBoxColumn.ItemsSource>
                                    <x:Array Type="sys:String" xmlns:sys="clr-namespace:System;assembly=mscorlib">
                                        <sys:String>weekly</sys:String>
                                        <sys:String>monthly</sys:String>
                                        <sys:String>excluded</sys:String>
                                    </x:Array>
                                </DataGridComboBoxColumn.ItemsSource>
                            </DataGridComboBoxColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="5,8">
                        <Button Content="➕ Add Employee" Click="BtnAddEmployee_Click" Padding="12,6" FontSize="14" Margin="0,0,10,0"/>
                        <TextBlock Text="💡 Or edit directly in the grid. Press Delete to remove a row."
                                   VerticalAlignment="Center" FontSize="12" Foreground="Gray"/>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="⚠️ Issues" x:Name="IssuesTab">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="IssuesGrid" Grid.Row="0" FontSize="13" SelectionMode="Extended" AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="160" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Day" Binding="{Binding DayLabel}" Width="120" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="100" IsReadOnly="True"/>
                            <DataGridTextColumn Header="IN" Binding="{Binding InTime}" Width="70" IsReadOnly="True"/>
                            <DataGridTextColumn Header="OUT (edit)" Binding="{Binding OutTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="90" Foreground="Blue" FontWeight="Bold"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="5,8">
                        <Button Content="⚡ Auto-fill (IN+9h)" Click="BtnAutoResolve_Click" Padding="12,6" FontSize="14" Margin="0,0,10,0" ToolTip="Pre-fills OUT = IN + 9 hours for all"/>
                        <Button Content="✔ Resolve All" Click="BtnResolveAll_Click" Padding="12,6" FontSize="14" Margin="0,0,10,0" FontWeight="Bold"/>
                        <Button Content="Skip Selected" Click="BtnSkip_Click" Padding="12,6" FontSize="14" Margin="0,0,10,0"/>
                        <TextBlock Text="💡 Double-click OUT column to edit times, then click Resolve All" VerticalAlignment="Center" FontSize="12" Foreground="Gray"/>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="📡 Device">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Device IP:" VerticalAlignment="Center" FontSize="14" Margin="0,0,8,0"/>
                        <TextBox x:Name="TxtDeviceIp" Width="150" FontSize="14" Text="192.168.1.10" Padding="4" VerticalContentAlignment="Center"/>
                        <TextBlock Text="Port:" VerticalAlignment="Center" FontSize="14" Margin="15,0,8,0"/>
                        <TextBox x:Name="TxtDevicePort" Width="70" FontSize="14" Text="5005" Padding="4" VerticalContentAlignment="Center"/>
                        <Button x:Name="BtnDeviceConnect" Content="🔌 Connect" Click="BtnDeviceConnect_Click"
                                Padding="14,8" FontSize="14" Margin="15,0,0,0" Background="#DDDDDD"/>
                    </StackPanel>

                    <StackPanel x:Name="PnlDeviceImport" Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10" Visibility="Collapsed">
                        <TextBlock Text="From:" VerticalAlignment="Center" FontSize="14" Margin="0,0,8,0"/>
                        <DatePicker x:Name="DpFrom" FontSize="13" Width="140"/>
                        <TextBlock Text="To:" VerticalAlignment="Center" FontSize="14" Margin="15,0,8,0"/>
                        <DatePicker x:Name="DpTo" FontSize="13" Width="140"/>
                        <Button x:Name="BtnDeviceImport" Content="📥 Import Attendance" Click="BtnDeviceImport_Click"
                                Padding="14,8" FontSize="14" Margin="15,0,0,0"/>
                        <Button x:Name="BtnDeviceToSalary" Content="📋 Use for Salary" Click="BtnDeviceToSalary_Click"
                                Padding="14,8" FontSize="14" Margin="10,0,0,0" IsEnabled="False"/>
                    </StackPanel>

                    <TextBlock x:Name="TxtDeviceStatus" Grid.Row="2" FontSize="13" Foreground="Gray" Margin="0,0,0,8" TextWrapping="Wrap"/>
                    <DataGrid x:Name="DeviceLogsGrid" Grid.Row="3" FontSize="13" IsReadOnly="True"/>
                </Grid>
            </TabItem>
            <TabItem Header="📈 Analytics">
                <local:AnalyticsTab/>
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <StatusBar Grid.Row="3">
            <TextBlock x:Name="StatusText" Text="Ready. Load an attendance file to begin." FontSize="13"/>
        </StatusBar>
    </Grid>
</Window>
