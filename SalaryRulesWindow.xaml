<Window x:Class="LuksAttendance.SalaryRulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Salary Rules &amp; OT Configuration" Height="700" Width="650"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Icon="Assets/logo.png">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="📐 Salary Rules &amp; OT Configuration" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Rules display -->
                <Border Background="#F8F9FC" Padding="14" CornerRadius="6">
                    <TextBlock x:Name="TxtRules" TextWrapping="Wrap" FontSize="11" FontFamily="Consolas" LineHeight="16"/>
                </Border>

                <!-- OT-Exempt Config -->
                <Border Background="#FFF8E1" Padding="16" CornerRadius="6" Margin="0,12,0,0" BorderBrush="#FFD54F" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="⚙️ OT-Exempt Configuration" FontSize="15" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBlock Text="Block OT calculations for entire categories or specific employees. Attendance still shows OT/deduction hours, but salary = Days × DailyRate only."
                                   TextWrapping="Wrap" FontSize="11" Foreground="Gray" Margin="0,0,0,12"/>

                        <!-- Current exempt list -->
                        <TextBlock Text="Currently OT-Exempt:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ListBox x:Name="LstExempt" Height="100" Margin="0,0,0,10" FontSize="13">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button Content="➖ Remove Selected" Click="BtnRemoveExempt_Click" Padding="10,4" FontSize="12" HorizontalAlignment="Left" Margin="0,0,0,12"/>

                        <Separator Margin="0,4,0,12"/>

                        <!-- Add new exempt -->
                        <TextBlock Text="Add OT-Exempt:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Type:" VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0"/>
                            <ComboBox x:Name="CmbExemptType" Width="140" FontSize="13" SelectionChanged="CmbExemptType_Changed">
                                <ComboBoxItem Content="Category" IsSelected="True"/>
                                <ComboBoxItem Content="Employee"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Search box + dropdown list -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Search:" VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0"/>
                            <TextBox x:Name="TxtSearch" Width="280" FontSize="13" TextChanged="TxtSearch_TextChanged" Padding="4,3"/>
                            <Button Content="➕ Add" Click="BtnAddExempt_Click" Padding="12,4" FontSize="13" Margin="8,0,0,0"/>
                        </StackPanel>

                        <!-- Live search results -->
                        <ListBox x:Name="LstSearchResults" Height="90" Margin="0,4,0,0" FontSize="13"
                                 SelectionChanged="LstSearchResults_SelectionChanged"/>

                        <TextBlock x:Name="TxtExemptStatus" Text="" FontSize="11" Foreground="Green" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2" Content="Close" Click="BtnClose_Click" Padding="14,8" FontSize="14" HorizontalAlignment="Right" Margin="0,12,0,0"/>
    </Grid>
</Window>
