<Window x:Class="LuksAttendance.PayrollWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Run Payroll" Height="650" Width="950"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Icon="Assets/logo.png">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Progress Header -->
        <Border Grid.Row="0" Background="#1a237e" Padding="12,10">
            <StackPanel>
                <TextBlock x:Name="TxtStepTitle" Text="Step 1 of 4: Select Period" FontSize="16" FontWeight="Bold" Foreground="White"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock x:Name="Step1Label" Text="① Period" Foreground="Yellow" FontSize="12" Margin="0,0,15,0"/>
                    <TextBlock x:Name="Step2Label" Text="② Import" Foreground="#AAB8D2" FontSize="12" Margin="0,0,15,0"/>
                    <TextBlock x:Name="Step3Label" Text="③ Issues" Foreground="#AAB8D2" FontSize="12" Margin="0,0,15,0"/>
                    <TextBlock x:Name="Step4Label" Text="④ Review &amp; Export" Foreground="#AAB8D2" FontSize="12"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Steps Content -->
        <TabControl x:Name="StepTabs" Grid.Row="1" Margin="0" BorderThickness="0">
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem"><Setter Property="Visibility" Value="Collapsed"/></Style>
            </TabControl.ItemContainerStyle>

            <!-- Step 1: Period -->
            <TabItem>
                <StackPanel Margin="30">
                    <TextBlock Text="Select payroll period" FontSize="16" FontWeight="Bold" Margin="0,0,0,20"/>
                    <RadioButton x:Name="RbWeekly" Content="Weekly employees" IsChecked="True" FontSize="14" Margin="0,0,0,8" GroupName="Mode"/>
                    <RadioButton x:Name="RbMonthly" Content="Monthly employees" FontSize="14" Margin="0,0,0,20" GroupName="Mode"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Start date:" FontSize="14" VerticalAlignment="Center" Width="90"/>
                        <DatePicker x:Name="DpWizStart" Width="160" FontSize="13"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="End date:" FontSize="14" VerticalAlignment="Center" Width="90"/>
                        <DatePicker x:Name="DpWizEnd" Width="160" FontSize="13"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtPeriodInfo" Text="" FontSize="13" Foreground="Gray" Margin="0,15,0,0"/>
                </StackPanel>
            </TabItem>

            <!-- Step 2: Import -->
            <TabItem>
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Import attendance data" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
                        <Button x:Name="BtnWizLoadFile" Content="📂 Load from Excel" Click="BtnWizLoadFile_Click" Padding="14,8" FontSize="14" Margin="0,0,10,0"/>
                        <Button x:Name="BtnWizLoadDevice" Content="📡 Load from Device" Click="BtnWizLoadDevice_Click" Padding="14,8" FontSize="14"/>
                    </StackPanel>
                    <Border Grid.Row="2" Background="#F5F5F5" Padding="15" CornerRadius="4">
                        <StackPanel x:Name="PnlWizSummary">
                            <TextBlock Text="Import Summary" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                            <TextBlock x:Name="TxtWizSummary" Text="No data imported yet. Click a button above to import." FontSize="13" TextWrapping="Wrap" Foreground="Gray"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Step 3: Issues -->
            <TabItem>
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Resolve issues" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                    <DataGrid x:Name="WizIssuesGrid" Grid.Row="1" FontSize="13" AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="150" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Day" Binding="{Binding DayLabel}" Width="110" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="100" IsReadOnly="True"/>
                            <DataGridTextColumn Header="IN" Binding="{Binding InTime}" Width="60" IsReadOnly="True"/>
                            <DataGridTextColumn Header="OUT (edit)" Binding="{Binding OutTime, Mode=TwoWay}" Width="80" Foreground="Blue" FontWeight="Bold"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="⚡ Auto-fill (IN+9h)" Click="BtnWizAutoFill_Click" Padding="10,6" FontSize="13" Margin="0,0,8,0"/>
                        <Button Content="✔ Resolve All" Click="BtnWizResolveAll_Click" Padding="10,6" FontSize="13"/>
                        <TextBlock x:Name="TxtWizIssueCount" Text="" FontSize="12" Foreground="Gray" VerticalAlignment="Center" Margin="15,0,0,0"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Step 4: Review & Export -->
            <TabItem>
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#E8F5E9" Padding="12" CornerRadius="4" Margin="0,0,0,10">
                        <TextBlock x:Name="TxtWizTotals" FontSize="14" FontWeight="Bold"/>
                    </Border>
                    <DataGrid x:Name="WizSalaryGrid" Grid.Row="1" FontSize="13" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="⚡" Binding="{Binding StatusIndicator}" Width="30"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="100"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="140"/>
                            <DataGridTextColumn Header="Days" Binding="{Binding Days}" Width="45"/>
                            <DataGridTextColumn Header="OT" Binding="{Binding OtHours}" Width="45"/>
                            <DataGridTextColumn Header="Ded" Binding="{Binding DedHours}" Width="45"/>
                            <DataGridTextColumn Header="Net Salary" Binding="{Binding NetSalary}" Width="100" FontWeight="Bold"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="📊 Export Excel" Click="BtnWizExcel_Click" Padding="12,6" FontSize="13" Margin="0,0,8,0"/>
                        <Button Content="📄 Export PDF" Click="BtnWizPdf_Click" Padding="12,6" FontSize="13" Margin="0,0,8,0"/>
                        <Button Content="🖨️ Print" Click="BtnWizPrint_Click" Padding="12,6" FontSize="13"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Navigation -->
        <Border Grid.Row="2" BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="15,10">
            <DockPanel>
                <Button Content="Cancel" Click="BtnWizCancel_Click" DockPanel.Dock="Left" Padding="14,8" FontSize="13"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="BtnWizBack" Content="← Back" Click="BtnWizBack_Click" Padding="14,8" FontSize="13" Margin="0,0,8,0" IsEnabled="False"/>
                    <Button x:Name="BtnWizNext" Content="Next →" Click="BtnWizNext_Click" Padding="14,8" FontSize="13" FontWeight="Bold"/>
                </StackPanel>
                <TextBlock/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
