<UserControl x:Class="LuksAttendance.AnalyticsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header + Refresh -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="📈 Salary Analytics &amp; Forecasting" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button x:Name="BtnRefresh" Content="🔄 Refresh" Click="BtnRefresh_Click" Padding="12,6" FontSize="13" Margin="20,0,0,0"/>
            <TextBlock x:Name="TxtDbInfo" Text="" FontSize="12" Foreground="Gray" VerticalAlignment="Center" Margin="20,0,0,0"/>
        </StackPanel>

        <!-- Top Row: Payroll Trend + Forecast -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Weekly Payroll Trend" Margin="0,0,5,5" FontSize="12">
                <lvc:CartesianChart x:Name="PayrollTrendChart"/>
            </GroupBox>

            <GroupBox Grid.Column="1" Header="Category Breakdown (Latest)" Margin="5,0,0,5" FontSize="12">
                <lvc:PieChart x:Name="CategoryPieChart"/>
            </GroupBox>
        </Grid>

        <!-- Bottom Row: OT Trend + Forecast Info -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Top 5 — Overtime Hours per Week" Margin="0,5,5,0" FontSize="12">
                <lvc:CartesianChart x:Name="OtTrendChart"/>
            </GroupBox>

            <GroupBox Grid.Column="1" Header="Forecast (Next 4 Weeks)" Margin="5,5,0,0" FontSize="12">
                <StackPanel x:Name="ForecastPanel" Margin="10" VerticalAlignment="Center"/>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>
