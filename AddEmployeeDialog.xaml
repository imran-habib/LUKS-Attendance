<Window x:Class="LuksAttendance.AddEmployeeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Employee" Height="320" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Text="Name:" FontSize="14" VerticalAlignment="Center" Margin="0,0,0,8"/>
        <TextBox x:Name="TxtName" Grid.Row="0" Grid.Column="1" FontSize="14" Padding="6" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="1" Text="Daily Rate:" FontSize="14" VerticalAlignment="Center" Margin="0,0,0,8"/>
        <TextBox x:Name="TxtRate" Grid.Row="1" Grid.Column="1" FontSize="14" Padding="6" Margin="0,0,0,8" Text="1000"/>

        <TextBlock Grid.Row="2" Text="Category:" FontSize="14" VerticalAlignment="Center" Margin="0,0,0,8"/>
        <ComboBox x:Name="CmbCategory" Grid.Row="2" Grid.Column="1" FontSize="14" Padding="6" Margin="0,0,0,8"
                  IsEditable="True">
            <ComboBoxItem Content="Cushioning"/>
            <ComboBoxItem Content="Polishing"/>
            <ComboBoxItem Content="Carpenter"/>
            <ComboBoxItem Content="Helper"/>
            <ComboBoxItem Content="Other"/>
        </ComboBox>

        <TextBlock Grid.Row="3" Text="Type:" FontSize="14" VerticalAlignment="Center" Margin="0,0,0,8"/>
        <ComboBox x:Name="CmbType" Grid.Row="3" Grid.Column="1" FontSize="14" Padding="6" Margin="0,0,0,8">
            <ComboBoxItem Content="weekly" IsSelected="True"/>
            <ComboBoxItem Content="monthly"/>
            <ComboBoxItem Content="excluded"/>
        </ComboBox>

        <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" Click="BtnCancel_Click" Padding="14,8" FontSize="14" Margin="0,0,10,0"/>
            <Button Content="✔ Add" Click="BtnAdd_Click" Padding="14,8" FontSize="14" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>
