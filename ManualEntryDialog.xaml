<Window x:Class="LuksAttendance.ManualEntryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Manual Entry" Height="450" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Employee Search -->
        <TextBlock Grid.Row="0" Text="Employee Name:" FontSize="14" Margin="0,0,0,5"/>
        <TextBox x:Name="TxtSearch" Grid.Row="1" FontSize="14" Padding="6"
                 TextChanged="TxtSearch_TextChanged"/>
        <ListBox x:Name="LstSuggestions" Grid.Row="2" MaxHeight="80" FontSize="13"
                 SelectionChanged="LstSuggestions_SelectionChanged" Margin="0,2,0,8"/>

        <!-- Date Range (shown when no existing days) -->
        <StackPanel x:Name="PnlDateRange" Grid.Row="3" Margin="0,0,0,8">
            <TextBlock Text="Select date range:" FontSize="14" Margin="0,0,0,5"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="From:" VerticalAlignment="Center" FontSize="13" Margin="0,0,8,0"/>
                <DatePicker x:Name="DpManualFrom" Width="140" FontSize="13"/>
                <TextBlock Text="To:" VerticalAlignment="Center" FontSize="13" Margin="15,0,8,0"/>
                <DatePicker x:Name="DpManualTo" Width="140" FontSize="13"/>
            </StackPanel>
        </StackPanel>

        <!-- Day Selection (shown when existing days available) -->
        <TextBlock Grid.Row="4" Text="Select days:" FontSize="14" Margin="0,0,0,3" VerticalAlignment="Top"/>
        <ListBox x:Name="LstDates" Grid.Row="4" Margin="0,24,0,0" SelectionMode="Multiple" FontSize="13"/>

        <!-- IN/OUT Times -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,10,0,10">
            <TextBlock Text="IN:" VerticalAlignment="Center" FontSize="14" Margin="0,0,8,0"/>
            <TextBox x:Name="TxtInTime" Width="70" FontSize="14" Text="08:00" Padding="4" VerticalContentAlignment="Center"/>
            <TextBlock Text="OUT:" VerticalAlignment="Center" FontSize="14" Margin="20,0,8,0"/>
            <TextBox x:Name="TxtOutTime" Width="70" FontSize="14" Text="17:00" Padding="4" VerticalContentAlignment="Center"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Click="BtnCancel_Click" Padding="14,8" FontSize="14" Margin="0,0,10,0"/>
            <Button Content="✔ Add Entries" Click="BtnAdd_Click" Padding="14,8" FontSize="14" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>
