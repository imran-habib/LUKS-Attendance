<Window x:Class="LuksAttendance.ManualEntryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Manual Entry" Height="400" Width="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Employee Search -->
        <TextBlock Grid.Row="0" Text="Employee Name:" FontSize="14" Margin="0,0,0,5"/>
        <TextBox x:Name="TxtSearch" Grid.Row="1" FontSize="14" Padding="6"
                 TextChanged="TxtSearch_TextChanged"/>
        <ListBox x:Name="LstSuggestions" Grid.Row="2" MaxHeight="80" FontSize="13"
                 SelectionChanged="LstSuggestions_SelectionChanged" Margin="0,2,0,8"/>

        <!-- Date Selection -->
        <TextBlock Grid.Row="3" Text="Select days to add:" FontSize="14" Margin="0,5,0,5" VerticalAlignment="Top"/>
        <ListBox x:Name="LstDates" Grid.Row="3" Margin="0,28,0,0" SelectionMode="Multiple" FontSize="13"/>

        <!-- IN/OUT Times -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,10,0,10">
            <TextBlock Text="IN:" VerticalAlignment="Center" FontSize="14" Margin="0,0,8,0"/>
            <TextBox x:Name="TxtInTime" Width="70" FontSize="14" Text="08:00" Padding="4" VerticalContentAlignment="Center"/>
            <TextBlock Text="OUT:" VerticalAlignment="Center" FontSize="14" Margin="20,0,8,0"/>
            <TextBox x:Name="TxtOutTime" Width="70" FontSize="14" Text="17:00" Padding="4" VerticalContentAlignment="Center"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Click="BtnCancel_Click" Padding="14,8" FontSize="14" Margin="0,0,10,0"/>
            <Button Content="✔ Add Entries" Click="BtnAdd_Click" Padding="14,8" FontSize="14" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>
